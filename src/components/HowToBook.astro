---
import { buildWhatsAppLink } from '../utils/whatsapp';

const pasos = [
  {
    numero: '01',
    titulo: 'Elige tu estilo',
    descripcion:
      'Explora nuestro catálogo y encuentra el estilo de pestañas que mejor va con tu mirada y personalidad.',
    icon: '👁️',
  },
  {
    numero: '02',
    titulo: 'Contáctanos',
    descripcion:
      'Escríbenos por WhatsApp con el estilo que te interesa. Te responderemos rápido para confirmar disponibilidad.',
    icon: '💬',
  },
  {
    numero: '03',
    titulo: 'Disfruta tu cita',
    descripcion:
      'Llega a tu cita y relájate. Nos encargamos del resto para que salgas con una mirada espectacular.',
    icon: '✨',
  },
];

const whatsappHref = buildWhatsAppLink();
---

<section class="how section section--alt" id="como-reservar" aria-labelledby="how-title">
  <div class="container">
    <div class="how__header">
      <p class="how__eyebrow">Reserva fácil</p>
      <hr class="divider" aria-hidden="true" />
      <h2 class="section-title" id="how-title">¿Cómo reservar tu cita?</h2>
      <p class="section-subtitle">
        En solo 3 pasos sencillos puedes tener tu cita agendada.
      </p>
    </div>

    <ol class="how__steps" aria-label="Pasos para reservar una cita">
      {pasos.map(({ numero, titulo, descripcion, icon }) => (
        <li class="how__step">
          <div class="how__step-icon" aria-hidden="true">{icon}</div>
          <div class="how__step-number" aria-hidden="true">{numero}</div>
          <h3 class="how__step-title">{titulo}</h3>
          <p class="how__step-desc">{descripcion}</p>
        </li>
      ))}
    </ol>

    <div class="how__cta">
      <a
        href={whatsappHref}
        class="btn btn--primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Agendar mi cita por WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        Agendar mi cita ahora
      </a>
    </div>
  </div>
</section>

<style>
  .how__header {
    margin-bottom: var(--space-12);
  }

  .how__eyebrow {
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
    max-width: none;
  }

  .how__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    list-style: none;
    position: relative;
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .how__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    /* Línea conectora entre pasos en desktop */
    .how__steps::before {
      content: '';
      position: absolute;
      top: 56px;
      left: calc(16.66% + var(--space-3));
      right: calc(16.66% + var(--space-3));
      height: 1px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
      opacity: 0.4;
    }
  }

  .how__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .how__step-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-2);
  }

  .how__step-number {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    box-shadow: var(--shadow-sm);
  }

  .how__step-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .how__step-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 28ch;
    margin-inline: auto;
  }

  .how__cta {
    display: flex;
    justify-content: center;
  }

  .how__cta .btn {
    padding: var(--space-4) var(--space-10);
    font-size: var(--text-base);
  }
</style>
