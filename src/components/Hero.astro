---
import { business } from '../data/business';
import { buildWhatsAppLink } from '../utils/whatsapp';

const whatsappHref = buildWhatsAppLink();
---

<section class="hero" id="inicio" aria-label="Presentación del negocio">
  <div class="hero__bg-pattern" aria-hidden="true"></div>
  <div class="container hero__container">
    <div class="hero__content">
      <p class="hero__eyebrow">
        <span aria-hidden="true">✦</span>
        Especialistas en pestañas
      </p>
      <h1 class="hero__title">{business.nombre}</h1>
      <p class="hero__eslogan">{business.eslogan}</p>
      <p class="hero__description">{business.descripcion}</p>

      <div class="hero__actions">
        <a
          href={whatsappHref}
          class="btn btn--primary hero__cta"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Agendar cita por WhatsApp con ${business.nombre}`}
        >
          <svg
            class="hero__wa-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          Agendar por WhatsApp
        </a>
        <a href="#servicios" class="btn btn--outline">
          Ver catálogo
        </a>
      </div>

      <ul class="hero__features" role="list" aria-label="Características del servicio">
        <li class="hero__feature">
          <span class="hero__feature-icon" aria-hidden="true">✓</span>
          Productos certificados
        </li>
        <li class="hero__feature">
          <span class="hero__feature-icon" aria-hidden="true">✓</span>
          Técnicas profesionales
        </li>
        <li class="hero__feature">
          <span class="hero__feature-icon" aria-hidden="true">✓</span>
          Atención personalizada
        </li>
      </ul>
    </div>

    <!-- Imagen hero decorativa -->
    <div class="hero__image-wrap" aria-hidden="true">
      <div class="hero__image-placeholder">
        <p class="hero__image-note">
          ⚠️ Reemplaza esta sección con una imagen real del negocio<br />
          Tamaño recomendado: 600×700px
        </p>
      </div>
      <div class="hero__image-deco hero__image-deco--1"></div>
      <div class="hero__image-deco hero__image-deco--2"></div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll-indicator" aria-hidden="true">
    <div class="hero__scroll-dot"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .hero__bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse at 80% 20%, rgba(201, 137, 122, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 20% 80%, rgba(201, 169, 110, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-20);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero__container {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-16);
    }
  }

  /* Contenido */
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    max-width: none;
    line-height: var(--leading-normal);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: var(--font-semibold);
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .hero__eslogan {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    font-style: italic;
    color: var(--color-primary-dark);
    max-width: none;
    line-height: var(--leading-normal);
  }

  .hero__description {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__cta {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
  }

  .hero__wa-icon {
    flex-shrink: 0;
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin-top: var(--space-2);
  }

  .hero__feature {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__feature-icon {
    color: var(--color-accent-dark);
    font-weight: var(--font-semibold);
  }

  /* Imagen */
  .hero__image-wrap {
    position: relative;
    display: none;
  }

  @media (min-width: 768px) {
    .hero__image-wrap {
      display: block;
    }
  }

  .hero__image-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    background: linear-gradient(135deg, var(--color-bg-alt), var(--color-border));
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border: 2px dashed var(--color-border);
  }

  .hero__image-note {
    max-width: none;
    line-height: var(--leading-relaxed);
  }

  .hero__image-deco {
    position: absolute;
    border-radius: var(--radius-full);
    opacity: 0.15;
  }

  .hero__image-deco--1 {
    width: 120px;
    height: 120px;
    background-color: var(--color-primary);
    top: -20px;
    right: -20px;
  }

  .hero__image-deco--2 {
    width: 80px;
    height: 80px;
    background-color: var(--color-accent);
    bottom: 30px;
    left: -30px;
  }

  /* Scroll indicator */
  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__scroll-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    animation: scrollBounce 1.5s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(8px); opacity: 0.5; }
  }
</style>
