---
import { business } from '../data/business';
import { buildWhatsAppLink } from '../utils/whatsapp';

const whatsappHref = buildWhatsAppLink();
---

<section class="contact section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__header">
      <p class="contact__eyebrow">Contáctanos</p>
      <hr class="divider" aria-hidden="true" />
      <h2 class="section-title" id="contact-title">¿Lista para agendar?</h2>
      <p class="section-subtitle">
        Escríbenos por WhatsApp y agenda tu cita de forma rápida y sencilla.
      </p>
    </div>

    <div class="contact__content">
      <!-- Bloque principal de WhatsApp -->
      <div class="contact__wa-block">
        <div class="contact__wa-icon-wrap" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
        </div>
        <h3 class="contact__wa-title">Escríbenos ahora</h3>
        <p class="contact__wa-text">
          Respondemos rápido. Cuéntanos qué estilo te gusta y te damos disponibilidad y precios.
        </p>
        <a
          href={whatsappHref}
          class="btn btn--whatsapp contact__wa-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Abrir WhatsApp para contactar a ${business.nombre}`}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          Abrir WhatsApp
        </a>
      </div>

      <!-- Info adicional -->
      <div class="contact__info">
        <dl class="contact__details">
          <div class="contact__detail-item">
            <dt class="contact__detail-label">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                <circle cx="12" cy="9" r="2.5" />
              </svg>
              Ubicación
            </dt>
            <dd class="contact__detail-value">{business.ubicacion}</dd>
          </div>

          <div class="contact__detail-item">
            <dt class="contact__detail-label">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              Horario
            </dt>
            <dd class="contact__detail-value">{business.horario}</dd>
          </div>

          {business.redes.instagram && (
            <div class="contact__detail-item">
              <dt class="contact__detail-label">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
                Instagram
              </dt>
              <dd class="contact__detail-value">
                <a
                  href={business.redes.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact__social-link"
                  aria-label={`Visitar Instagram de ${business.nombre}`}
                >
                  {business.redes.instagram.replace('https://instagram.com/', '@')}
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__header {
    margin-bottom: var(--space-12);
  }

  .contact__eyebrow {
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
    max-width: none;
  }

  .contact__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 800px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .contact__content {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  /* Bloque WhatsApp */
  .contact__wa-block {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .contact__wa-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background-color: #25d366;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .contact__wa-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .contact__wa-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 30ch;
    line-height: var(--leading-relaxed);
  }

  .contact__wa-btn {
    padding: var(--space-3) var(--space-8);
    margin-top: var(--space-2);
  }

  /* Info de contacto */
  .contact__info {
    padding: var(--space-6) 0;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact__detail-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact__detail-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .contact__detail-label svg {
    flex-shrink: 0;
  }

  .contact__detail-value {
    font-size: var(--text-base);
    color: var(--color-text);
    padding-left: calc(18px + var(--space-2));
  }

  .contact__social-link {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .contact__social-link:hover {
    color: var(--color-accent-dark);
  }
</style>
