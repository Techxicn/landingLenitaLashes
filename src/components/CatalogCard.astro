---
import { Image } from 'astro:assets';
import type { LashStyle } from '../data/catalog';
import { buildCatalogWhatsAppLink } from '../utils/whatsapp';

interface Props {
  style: LashStyle;
}

const { style } = Astro.props;
const whatsappHref = buildCatalogWhatsAppLink(style.nombre);
---

<article class="catalog-card" aria-label={`Servicio: ${style.nombre}`}>
  <!-- Imagen -->
  <div class="catalog-card__image-wrap">
    <Image
      src={style.imagen}
      alt={style.imagenAlt}
      width={400}
      height={300}
      loading="lazy"
      class="catalog-card__image"
      quality={80}
    />
    {style.etiqueta && (
      <span class="badge catalog-card__badge" aria-label={`Etiqueta: ${style.etiqueta}`}>
        {style.etiqueta}
      </span>
    )}
  </div>

  <!-- Contenido -->
  <div class="catalog-card__body">
    <h3 class="catalog-card__title">{style.nombre}</h3>
    <p class="catalog-card__desc">{style.descripcion}</p>

    <div class="catalog-card__meta" aria-label="Detalles del servicio">
      {style.duracion && (
        <span class="catalog-card__meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span>{style.duracion}</span>
        </span>
      )}
      {style.precio && (
        <span class="catalog-card__precio">{style.precio}</span>
      )}
    </div>

    <a
      href={whatsappHref}
      class="btn btn--primary catalog-card__btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Me interesa el estilo ${style.nombre} — Contactar por WhatsApp`}
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
      Me interesa
    </a>
  </div>
</article>

<style>
  .catalog-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .catalog-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-card:hover {
      transform: none;
    }
  }

  .catalog-card__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .catalog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .catalog-card:hover .catalog-card__image {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-card:hover .catalog-card__image {
      transform: none;
    }
  }

  .catalog-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
  }

  .catalog-card__body {
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .catalog-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .catalog-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
    max-width: none;
  }

  .catalog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .catalog-card__meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .catalog-card__meta-item svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .catalog-card__precio {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-primary-dark);
  }

  .catalog-card__btn {
    width: 100%;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
</style>
